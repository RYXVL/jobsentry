# Copy this file to `.env` (same folder) and edit as needed.
# Real environment variables take priority over values in `.env`.

# ----- Scraping ---------------------------------------------------------

# Where JSON output is written. Relative paths are relative to backend/.
JOBSENTRY_DATA_DIR=data

# Seconds to wait for each HTTP request.
JOBSENTRY_HTTP_TIMEOUT=30

# Retries on 429/5xx responses and connection errors.
JOBSENTRY_HTTP_RETRIES=3

# User-Agent sent to career sites.
JOBSENTRY_USER_AGENT=jobsentry/0.1.0

# ----- Fetch all jobs ---------------------------------------------------

# How many companies are fetched at the same time (1-32).
JOBSENTRY_REFRESH_WORKERS=5

# Platforms in the order "Fetch all jobs" works through them (comma-separated).
# Within a platform, companies go in the order of its catalog file.
JOBSENTRY_REFRESH_ORDER=ashby,greenhouse,lever,smartrecruiters

# Time zone for "today" in data/todays-jobs.json, as an IANA name.
# Leave empty to use this computer's time zone.
JOBSENTRY_TIMEZONE=

# ----- Managing sources from the website --------------------------------

# Allow adding, editing and deleting sources (and their logos) from the
# website. Only safe while JOBSENTRY_API_HOST is 127.0.0.1 (this computer).
JOBSENTRY_ALLOW_CATALOG_EDITS=true

# Where uploaded logos are saved, as <name>.png (relative to backend/).
JOBSENTRY_LOGOS_DIR=../frontend/public/logos

# ----- Monitor email alerts ---------------------------------------------

# The mail server that sends alert emails. Leave JOBSENTRY_SMTP_HOST empty
# to turn email off. Gmail and Outlook need an "app password", not your
# normal password. After changing these, restart the API and send a test
# email from the Monitor page.
JOBSENTRY_SMTP_HOST=
JOBSENTRY_SMTP_PORT=587
# starttls (usual for port 587), ssl (usual for port 465) or none
JOBSENTRY_SMTP_SECURITY=starttls
JOBSENTRY_SMTP_USERNAME=
JOBSENTRY_SMTP_PASSWORD=
# The sender address, usually the same as the username.
JOBSENTRY_SMTP_FROM=

# ----- API --------------------------------------------------------------

JOBSENTRY_API_HOST=127.0.0.1
JOBSENTRY_API_PORT=8000

# Frontend URLs allowed to call the API (comma-separated, no spaces needed).
JOBSENTRY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000