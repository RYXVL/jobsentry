# Copy this file to `.env` (same folder) and edit as needed.
# Real environment variables take priority over values in `.env`.

# ----- Scraping ---------------------------------------------------------

# Where JSON output is written. Relative paths are relative to backend/.
JOBSENTRY_DATA_DIR=data

# Seconds to wait for each HTTP request.
JOBSENTRY_HTTP_TIMEOUT=30

# Retries on 429/5xx responses and connection errors.
JOBSENTRY_HTTP_RETRIES=3

# User-Agent sent to career sites.
JOBSENTRY_USER_AGENT=jobsentry/0.1.0

# ----- API --------------------------------------------------------------

JOBSENTRY_API_HOST=127.0.0.1
JOBSENTRY_API_PORT=8000

# Frontend URLs allowed to call the API (comma-separated, no spaces needed).
JOBSENTRY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
